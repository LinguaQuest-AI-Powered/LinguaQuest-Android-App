<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_lockscreen_card"
    android:padding="20dp">

    <!-- decorative corners -->
    <ImageView
        android:id="@+id/ivFlowerTL"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_flower_corner"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ivFlowerBR"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:rotation="180"
        android:src="@drawable/ic_flower_corner"
        android:contentDescription="@null" />

    <!-- main phrase -->
    <TextView
        android:id="@+id/tvWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivFlowerTL"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="#2E2A22"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        tools:text="وما توفيقي إلا بالله" />

    <!-- example sentence -->
    <TextView
        android:id="@+id/tvExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWord"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="#5A5346"
        android:textSize="13sp"
        android:textStyle="italic"
        tools:text="&quot;وإن مع العسر يسرا&quot;" />

    <!-- translation / meaning -->
    <TextView
        android:id="@+id/tvTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvExample"
        android:layout_above="@id/ivFlowerBR"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="#8A6D3B"
        android:textSize="12sp"
        tools:text="ترجمة أو تفسير مختصر" />

</RelativeLayout>
